# ==========================================================================
# AI Tutor - Shared Environment Variables
# Copy this file to .env and fill in real values for local development.
# ==========================================================================

# ---------- Database ----------
# Set USE_POSTGRES=true to use the docker-compose Postgres + pgvector container.
# Default (false) uses a local SQLite DB inside backend_api/ — zero setup.
USE_POSTGRES=false
POSTGRES_DB=ai_tutor
POSTGRES_USER=ai_tutor
POSTGRES_PASSWORD=ai_tutor_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Redis (optional cache / channel layer) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Django (backend_api) ----------
DJANGO_SECRET_KEY=change-me-in-production-please
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend_api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase ID-token verification only needs the project ID. The optional
# service-account JSON is *not* required for auth.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ---------- LLM service (proxies to a local OpenAI-compatible server) ----------
LLM_SERVICE_URL=http://localhost:8001
LLM_UPSTREAM_URL=http://127.0.0.1:1234
LLM_UPSTREAM_API_KEY=lm-studio
LLM_API_KEY=lm-studio
LLM_MODEL=meta-llama-3-8b-instruct
LLM_DEFAULT_SYSTEM_PROMPT=You are a helpful AI tutor. Be concise, friendly, and clear.

# ---------- TTS service ----------
# edge-tts (default) is multilingual, free, and pure-python.
# Other engines: qwen3-tts, vui, sine (debug beep).
TTS_SERVICE_URL=http://localhost:8002
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AriaNeural
TTS_SAMPLE_RATE=24000

# ---------- STT service ----------
STT_SERVICE_URL=http://localhost:8003
STT_MODEL=base
# device: cpu (default, safe), cuda (needs cuBLAS 12 in PATH).
STT_DEVICE=cpu
STT_LANGUAGE=en

# ---------- VAD service ----------
VAD_SERVICE_URL=http://localhost:8005

# ---------- Voice gateway ----------
VOICE_GATEWAY_URL=http://localhost:8004
BACKEND_API_URL=http://localhost:8000

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000
VITE_VOICE_WS_URL=ws://localhost:8004/ws/voice
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
